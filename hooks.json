{
  "usage-hud": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/hook-collector.mjs SessionStart",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hook-collector.mjs PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hook-collector.mjs PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/hook-collector.mjs PreInvocation",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/hook-collector.mjs PostInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/hook-collector.mjs Stop",
        "timeout": 5
      }
    ]
  }
}
